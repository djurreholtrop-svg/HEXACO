# API key used to authenticate Qualtrics webhook requests.
# Set this to a strong random string and configure the same value
# in your Qualtrics "Web Service" block as the X-API-Key header.
API_SECRET_KEY=change-me-to-a-random-secret

# Base URL of this application (used for generating participant links).
# Example: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
